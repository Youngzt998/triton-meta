// Minimal reproducer for r2-compile/HIT-0063.
//
// A Hopper `ttng.warp_group_dot` whose B operand sits in shared memory with a
// NON-TRIVIAL CGA (block) dimension: `#shared` has `CGALayout = [[1, 0]]`,
// i.e. the 32-row K dimension is split over the 2 CTAs of the CGA.
//
//   triton-opt --allocate-shared-memory-nv \
//              --convert-triton-gpu-to-llvm='compute-capability=90 ptx-version=88' \
//              wgmma-cga-min.ttgir
//
// -> Assertion `block == 0' failed
//    third_party/nvidia/lib/TritonNVIDIAGPUToLLVM/DotOpToLLVM/MMAHelpers.h:171
//
// Change ONLY `#shared`'s CGALayout to [[0, 0]] and the same file compiles.
#blocked = #ttg.blocked<{sizePerThread = [16, 1], threadsPerWarp = [1, 32], warpsPerCTA = [1, 4], order = [0, 1], CGALayout = [[1, 0]]}>
#mma = #ttg.nvidia_mma<{versionMajor = 3, versionMinor = 0, warpsPerCTA = [4, 1], CGALayout = [[0, 1]], instrShape = [16, 128, 16]}>
#shared = #ttg.nvmma_shared<{swizzlingByteWidth = 32, transposed = true, elementBitWidth = 16, CGALayout = [[1, 0]]}>
#smem = #ttg.shared_memory
module attributes {"ttg.num-ctas" = 2 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "cuda:90", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @wgmma_cga(
      %out: !tt.ptr<f32>,
      %a: tensor<128x32xf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 2}>>,
      %b: tensor<32x256xf16, #blocked>,
      %c: tensor<128x256xf32, #mma>) {
    %bs = ttg.local_alloc %b : (tensor<32x256xf16, #blocked>) -> !ttg.memdesc<32x256xf16, #shared, #smem>
    %d = ttng.warp_group_dot %a, %bs, %c : tensor<128x32xf16, #ttg.dot_op<{opIdx = 0, parent = #mma, kWidth = 2}>> * !ttg.memdesc<32x256xf16, #shared, #smem> -> tensor<128x256xf32, #mma>
    %p = tt.splat %out : !tt.ptr<f32> -> tensor<128x256x!tt.ptr<f32>, #mma>
    tt.store %p, %d : tensor<128x256x!tt.ptr<f32>, #mma>
    tt.return
  }
}
