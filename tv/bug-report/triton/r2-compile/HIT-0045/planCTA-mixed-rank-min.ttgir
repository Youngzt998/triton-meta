// Minimal reproducer: two stores of DIFFERENT RANK in one kernel, num_ctas > 1.
// CTAPlanner::processStoreLikeOps (PlanCTA.cpp:350) takes the CGA layout of the
// FIRST store-like op and then reuses it for every later store, so the rank-2
// store below is rebuilt with the rank-1 CGA layout of the first store.
#b1 = #ttg.blocked<{sizePerThread = [1], threadsPerWarp = [32], warpsPerCTA = [4], order = [0], CGALayout = [[0], [0], [0]]}>
#b2 = #ttg.blocked<{sizePerThread = [1, 1], threadsPerWarp = [1, 32], warpsPerCTA = [4, 1], order = [1, 0], CGALayout = [[0, 0], [0, 0], [0, 0]]}>
module attributes {"ttg.num-ctas" = 8 : i32, "ttg.num-warps" = 4 : i32, ttg.target = "cuda:90", "ttg.threads-per-warp" = 32 : i32} {
  tt.func public @two_stores_different_rank(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>) {
    %v0 = arith.constant dense<0.000000e+00> : tensor<32xf32, #b1>
    %v1 = arith.constant dense<0.000000e+00> : tensor<4x32xf32, #b2>
    %p0 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<32x!tt.ptr<f32>, #b1>
    %p1 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<4x32x!tt.ptr<f32>, #b2>
    tt.store %p0, %v0 : tensor<32x!tt.ptr<f32>, #b1>
    tt.store %p1, %v1 : tensor<4x32x!tt.ptr<f32>, #b2>
    tt.return
  }
}
