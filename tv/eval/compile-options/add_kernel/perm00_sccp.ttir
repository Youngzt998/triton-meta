// add_kernel TTIR — optimizations turned ON over the unoptimized standard:
//   triton-opt standard.ttir --sccp
// Expected vs standard.ttir: EQUIVALENT (each pass must preserve semantics).
module {
  tt.func public @add_kernel(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>, %arg3: i32) attributes {noinline = false} {
    %cst = arith.constant dense<-2147483648> : tensor<1024xi64>
    %cst_0 = arith.constant dense<2147483647> : tensor<1024xi64>
    %c-2147483648_i64 = arith.constant -2147483648 : i64
    %c2147483647_i64 = arith.constant 2147483647 : i64
    %c1024_i64 = arith.constant 1024 : i64
    %c1024_i32 = arith.constant 1024 : i32
    %0 = tt.get_program_id x : i32
    %1 = arith.extsi %0 : i32 to i64
    %2 = arith.muli %1, %c1024_i64 : i64
    %3 = arith.cmpi sle, %2, %c2147483647_i64 : i64
    %4 = arith.cmpi sge, %2, %c-2147483648_i64 : i64
    %5 = arith.andi %3, %4 : i1
    %6 = arith.muli %0, %c1024_i32 : i32
    %7 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32>
    %8 = tt.splat %6 : i32 -> tensor<1024xi32>
    %9 = arith.extsi %8 : tensor<1024xi32> to tensor<1024xi64>
    %10 = arith.extsi %7 : tensor<1024xi32> to tensor<1024xi64>
    %11 = arith.addi %9, %10 : tensor<1024xi64>
    %12 = arith.cmpi sle, %11, %cst_0 : tensor<1024xi64>
    %13 = arith.cmpi sge, %11, %cst : tensor<1024xi64>
    %14 = arith.andi %12, %13 : tensor<1024xi1>
    %15 = arith.addi %8, %7 : tensor<1024xi32>
    %16 = tt.splat %arg3 : i32 -> tensor<1024xi32>
    %17 = arith.cmpi slt, %15, %16 : tensor<1024xi32>
    %18 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %19 = tt.addptr %18, %15 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %20 = tt.load %19, %17 : tensor<1024x!tt.ptr<f32>>
    %21 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %22 = tt.addptr %21, %15 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %23 = tt.load %22, %17 : tensor<1024x!tt.ptr<f32>>
    %24 = arith.addf %20, %23 : tensor<1024xf32>
    %25 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %26 = tt.addptr %25, %15 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    tt.store %26, %24, %17 : tensor<1024x!tt.ptr<f32>>
    tt.return
  }
}

