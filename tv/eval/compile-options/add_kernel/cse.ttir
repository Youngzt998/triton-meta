module {
  tt.func public @add_kernel(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>, %arg3: i32) attributes {noinline = false} {
    %0 = tt.get_program_id x : i32
    %c1024_i32 = arith.constant 1024 : i32
    %1 = arith.extsi %0 : i32 to i64
    %2 = arith.extsi %c1024_i32 : i32 to i64
    %3 = arith.muli %1, %2 : i64
    %c2147483647_i64 = arith.constant 2147483647 : i64
    %c-2147483648_i64 = arith.constant -2147483648 : i64
    %4 = arith.cmpi sle, %3, %c2147483647_i64 : i64
    %5 = arith.cmpi sge, %3, %c-2147483648_i64 : i64
    %6 = arith.muli %0, %c1024_i32 : i32
    %7 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32>
    %8 = tt.splat %6 : i32 -> tensor<1024xi32>
    %9 = arith.extsi %8 : tensor<1024xi32> to tensor<1024xi64>
    %10 = arith.extsi %7 : tensor<1024xi32> to tensor<1024xi64>
    %11 = arith.addi %9, %10 : tensor<1024xi64>
    %cst = arith.constant dense<2147483647> : tensor<1024xi64>
    %12 = arith.cmpi sle, %11, %cst : tensor<1024xi64>
    %cst_0 = arith.constant dense<-2147483648> : tensor<1024xi64>
    %13 = arith.cmpi sge, %11, %cst_0 : tensor<1024xi64>
    %14 = arith.addi %8, %7 : tensor<1024xi32>
    %15 = tt.splat %arg3 : i32 -> tensor<1024xi32>
    %16 = arith.cmpi slt, %14, %15 : tensor<1024xi32>
    %17 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %18 = tt.addptr %17, %14 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %19 = tt.load %18, %16 : tensor<1024x!tt.ptr<f32>>
    %20 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %21 = tt.addptr %20, %14 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %22 = tt.load %21, %16 : tensor<1024x!tt.ptr<f32>>
    %23 = arith.addf %19, %22 : tensor<1024xf32>
    %24 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %25 = tt.addptr %24, %14 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
