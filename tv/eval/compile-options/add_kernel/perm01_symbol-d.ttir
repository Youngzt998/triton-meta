// add_kernel TTIR — optimizations turned ON over the unoptimized standard:
//   triton-opt standard.ttir --symbol-dce
// Expected vs standard.ttir: EQUIVALENT (each pass must preserve semantics).
module {
  tt.func public @add_kernel(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: !tt.ptr<f32>, %arg3: i32) attributes {noinline = false} {
    %0 = tt.get_program_id x : i32
    %c1024_i32 = arith.constant 1024 : i32
    %c1024_i32_0 = arith.constant 1024 : i32
    %1 = arith.extsi %0 : i32 to i64
    %2 = arith.extsi %c1024_i32_0 : i32 to i64
    %3 = arith.muli %1, %2 : i64
    %c2147483647_i64 = arith.constant 2147483647 : i64
    %c-2147483648_i64 = arith.constant -2147483648 : i64
    %4 = arith.cmpi sle, %3, %c2147483647_i64 : i64
    %5 = arith.cmpi sge, %3, %c-2147483648_i64 : i64
    %6 = arith.andi %4, %5 : i1
    %7 = arith.muli %0, %c1024_i32_0 : i32
    %8 = tt.make_range {end = 1024 : i32, start = 0 : i32} : tensor<1024xi32>
    %9 = tt.splat %7 : i32 -> tensor<1024xi32>
    %10 = arith.extsi %9 : tensor<1024xi32> to tensor<1024xi64>
    %11 = arith.extsi %8 : tensor<1024xi32> to tensor<1024xi64>
    %12 = arith.addi %10, %11 : tensor<1024xi64>
    %c2147483647_i64_1 = arith.constant 2147483647 : i64
    %c-2147483648_i64_2 = arith.constant -2147483648 : i64
    %cst = arith.constant dense<2147483647> : tensor<1024xi64>
    %13 = arith.cmpi sle, %12, %cst : tensor<1024xi64>
    %cst_3 = arith.constant dense<-2147483648> : tensor<1024xi64>
    %14 = arith.cmpi sge, %12, %cst_3 : tensor<1024xi64>
    %15 = arith.andi %13, %14 : tensor<1024xi1>
    %16 = arith.addi %9, %8 : tensor<1024xi32>
    %17 = tt.splat %arg3 : i32 -> tensor<1024xi32>
    %18 = arith.cmpi slt, %16, %17 : tensor<1024xi32>
    %19 = tt.splat %arg0 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %20 = tt.addptr %19, %16 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %21 = tt.load %20, %18 : tensor<1024x!tt.ptr<f32>>
    %22 = tt.splat %arg1 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %23 = tt.addptr %22, %16 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    %24 = tt.load %23, %18 : tensor<1024x!tt.ptr<f32>>
    %25 = arith.addf %21, %24 : tensor<1024xf32>
    %26 = tt.splat %arg2 : !tt.ptr<f32> -> tensor<1024x!tt.ptr<f32>>
    %27 = tt.addptr %26, %16 : tensor<1024x!tt.ptr<f32>>, tensor<1024xi32>
    tt.store %27, %25, %18 : tensor<1024x!tt.ptr<f32>>
    tt.return
  }
}

