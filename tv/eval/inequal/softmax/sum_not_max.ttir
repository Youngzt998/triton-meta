module {
  tt.func public @softmax_kernel(%arg0: !tt.ptr<f32>, %arg1: !tt.ptr<f32>, %arg2: i32, %arg3: i32, %arg4: i32) attributes {noinline = false} {
    %cst = arith.constant dense<0xFF800000> : tensor<8xf32>
    %0 = tt.get_program_id x : i32
    %1 = tt.make_range {end = 8 : i32, start = 0 : i32} : tensor<8xi32>
    %2 = tt.splat %arg4 : i32 -> tensor<8xi32>
    %3 = arith.cmpi slt, %1, %2 : tensor<8xi32>
    %4 = arith.muli %0, %arg2 : i32
    %5 = tt.addptr %arg1, %4 : !tt.ptr<f32>, i32
    %6 = tt.splat %5 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %7 = tt.addptr %6, %1 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    %8 = tt.load %7, %3, %cst : tensor<8x!tt.ptr<f32>>
    %9 = "tt.reduce"(%8) <{axis = 0 : i32}> ({
    ^bb0(%arg5: f32, %arg6: f32):
      %20 = arith.addf %arg5, %arg6 : f32
      tt.reduce.return %20 : f32
    }) : (tensor<8xf32>) -> f32
    %10 = tt.splat %9 : f32 -> tensor<8xf32>
    %11 = arith.subf %8, %10 : tensor<8xf32>
    %12 = math.exp %11 : tensor<8xf32>
    %13 = "tt.reduce"(%12) <{axis = 0 : i32}> ({
    ^bb0(%arg5: f32, %arg6: f32):
      %20 = arith.addf %arg5, %arg6 : f32
      tt.reduce.return %20 : f32
    }) : (tensor<8xf32>) -> f32
    %14 = tt.splat %13 : f32 -> tensor<8xf32>
    %15 = arith.divf %12, %14 : tensor<8xf32>
    %16 = arith.muli %0, %arg3 : i32
    %17 = tt.addptr %arg0, %16 : !tt.ptr<f32>, i32
    %18 = tt.splat %17 : !tt.ptr<f32> -> tensor<8x!tt.ptr<f32>>
    %19 = tt.addptr %18, %1 : tensor<8x!tt.ptr<f32>>, tensor<8xi32>
    tt.store %19, %15, %3 : tensor<8x!tt.ptr<f32>>
    tt.return
  }
}

